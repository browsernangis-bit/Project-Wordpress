{
  "$schema": "https://schemas.wp.org/trunk/theme.json",
  "version": 2,
  "title": "Linen",
  "settings": {
    "color": {
      "palette": [
        {
          "color": "#4A423A",
          "name": "Primary",
          "slug": "primary"
        },
        {
          "color": "#79706A",
          "name": "Mono 2",
          "slug": "mono-2"
        },
        {
          "color": "#FFFFFF",
          "name": "Contrast Light",
          "slug": "contrast-light"
        },
        {
          "color": "#2B2723",
          "name": "Contrast Dark",
          "slug": "contrast-dark"
        },
        {
          "color": "#FCFAF6",
          "name": "Base",
          "slug": "base"
        },
        {
          "color": "#2B2723",
          "name": "Mono 1",
          "slug": "mono-1"
        },
        {
          "color": "#E3DCD2",
          "name": "Mono 3",
          "slug": "mono-3"
        },
        {
          "color": "#F2EDE5",
          "name": "Mono 4",
          "slug": "mono-4"
        },
        {
          "color": "#2F2A24",
          "name": "Primary Hover",
          "slug": "primary-hover"
        },
        {
          "color": "#A44C33",
          "name": "Featured",
          "slug": "featured"
        }
      ]
    }
  },
  "styles": {
    "blocks": {
      "core/heading": {
        "typography": {
          "fontFamily": "var(--wp--preset--font-family--fontsecondary)"
        }
      },
      "core/post-title": {
        "typography": {
          "fontFamily": "var(--wp--preset--font-family--fontsecondary)",
          "fontWeight": "500",
          "letterSpacing": "-0.02em"
        }
      },
      "core/site-title": {
        "typography": {
          "fontFamily": "var(--wp--preset--font-family--fontsecondary)",
          "fontWeight": "500",
          "letterSpacing": "-0.02em"
        }
      }
    },
    "elements": {
      "button": {
        "border": {
          "radius": "2px"
        },
        "typography": {
          "fontWeight": "500",
          "letterSpacing": "0.02em"
        }
      },
      "h1": {
        "typography": {
          "lineHeight": "1.05"
        }
      },
      "h3": {
        "typography": {
          "fontFamily": "var(--wp--preset--font-family--fontsecondary)"
        }
      },
      "heading": {
        "typography": {
          "fontFamily": "var(--wp--preset--font-family--fontsecondary)",
          "fontWeight": "500",
          "letterSpacing": "-0.02em"
        }
      },
      "link": {
        "typography": {
          "textDecoration": "underline"
        },
        ":hover": {
          "typography": {
            "textDecoration": "none"
          }
        }
      }
    },
    "spacing": {
      "blockGap": "1.25rem"
    }
  }
}
